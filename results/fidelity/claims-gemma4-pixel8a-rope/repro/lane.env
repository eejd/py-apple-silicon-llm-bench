# lane.env — Gemma 4 E2B copy fidelity on a Pixel 8a (Mali-G715) through LiteRT-LM's Android CLI, one prompt per
# process (LiteRT-LM #3913, the rotary-position patches). Read by litertlm-convert's
# community_accel_work/devicebench/llm_prompt_chain.sh (bash 3.2; every value ${VAR:-value} so the caller's environment
# wins; ROUND, LANE_DIR, DEVICE_DIR, BENCH and CA are set by the chain before this file is sourced).
# This is the run's file with the lane's working-directory paths replaced by KIT (this directory); see README.md.
KIT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
LANE=${LANE:-g3913}
DEVICE=${DEVICE:-p8a}
SERIAL=${SERIAL:-4C131JEKB15210}
HOLD=${HOLD:-$CA/s2_npu_sweep/.device_hold.pixel8a}
# the line: ticket g3913-p8a-<round>, enqueued by the chain right before its keeper waits
SCRIPT_NAME=${SCRIPT_NAME:-g3913-p8a-$ROUND}
QUEUE_SUPERVISOR=${QUEUE_SUPERVISOR:-${USER:-repro}}
QUEUE_MINUTES=${QUEUE_MINUTES:-45}
# slot A leaves its undone legs to slot B (started before A releases; B queues behind the lanes already waiting)
case "$ROUND" in r2a) NEXT_ROUND=${NEXT_ROUND:-r2b} ;; *) NEXT_ROUND=${NEXT_ROUND:-} ;; esac
# clock: no new leg after 40 min, every process stopped by 44 min, the keeper releases at 45 min
SKIP_MIN=${SKIP_MIN:-40}; RUN_END_MIN=${RUN_END_MIN:-44}; END_MIN=${END_MIN:-45}
# logs: <KIT>/out/logs/<round>/<tag>.{out,err,meta.json,...}; the dry run moves them with LLM_LOG_BASE
ROUND_DIR=${ROUND_DIR:-${LLM_LOG_BASE:-$KIT/out/logs}/$ROUND}
RESULTS_DIR=${RESULTS_DIR:-$KIT/out/raw}
PLAN=${PLAN:-$KIT/plan_r2.tsv}
LLM_STAGE=${LLM_STAGE:-/data/local/tmp/g3913_rope}
LLM_PROMPTS=${LLM_PROMPTS:-$KIT/prompts}
LLM_MODELS=${LLM_MODELS:-$KIT/models.tsv}
# the kit: litert_lm_advanced_main and the 7 .so files of LiteRT-LM main@b7c40ea81 (android_arm64) with their SHA256SUMS
# (kit.SHA256SUMS here, copied in as SHA256SUMS); the chain refuses a kit whose sha256 differ. Set LLM_KIT to that
# directory.
LLM_KIT=${LLM_KIT:-}
LLM_BIN_SHA=${LLM_BIN_SHA:-ce1f25dc982413c08d4094898f4d34dd22032af3a776081ec3dc9c3d1ba15234}
LLM_RUNTIME=${LLM_RUNTIME:-"LiteRT-LM main@b7c40ea81 (b7c40ea8178b80919f7f5af79855c922a40bfaf7, 2026-10-13; LITERT_REF 9b8c7f77e7a29e6073e614a05e1e38be7b761229) android_arm64 litert_lm_advanced_main sha256 ce1f25dc982413c0 + the commit's 7 prebuilt android_arm64 .so"}
# the C API (PowerBeef's Swift runner) creates the engine without the prompt as a hint; the CLI passes it by default and
# then sets prefill_batch_sizes = {prompt tokens + margin} (v0.18.0 engine_settings.cc 382-393): off, as on the Mac
LLM_FIXED_ARGS=${LLM_FIXED_ARGS:---disable_input_prompt_as_hint=true}
# 8 GB phone: our own process is killed when MemAvailable falls under 500 MB (lmkd starts on background apps near 1 GB)
MEM_GUARD_KB=${MEM_GUARD_KB:-500000}
CACHE_EST=${CACHE_EST:-3000000000}
XFER_BPS=${XFER_BPS:-30000000}
# a keep leg that opens a hold runs cold (empty stage): its est is at least the cold legs' 240 s
COLD_EST_S=${COLD_EST_S:-240}
STANDIN=${STANDIN:-$KIT/standin_cli.py}
# the dry run (devicebench/dryrun_llm.sh): its plan and the stage-in models
LLM_DRY_PLAN=${LLM_DRY_PLAN:-$KIT/plan_dry.tsv}
LLM_DRY_LABELS=${LLM_DRY_LABELS:-orig:original r512:rope512}

lane_llm_score() {  # <round dir> <tag>: one record into RESULTS_DIR (exit 3 = prefill differs from the Mac's: stop)
  G3913_MODELS="$LLM_MODELS" G3913_RAW_DIR="$RESULTS_DIR" python3 -I "$KIT/score.py" leg "$1" "$2"
}
lane_done_tags() {
  G3913_RAW_DIR="$RESULTS_DIR" python3 -I "$KIT/score.py" tags
}
